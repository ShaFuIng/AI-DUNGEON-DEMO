{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-dungeon-demo.local/schemas/generatedArea.schema.json",
  "title": "Generated Area Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "theme",
    "narrativeHook",
    "difficulty",
    "rooms"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "minLength": 3
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "theme": {
      "type": "string",
      "minLength": 1
    },
    "narrativeHook": {
      "type": "string",
      "minLength": 1
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "rooms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "exits",
          "items",
          "monster"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$",
            "minLength": 3
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "exits": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "north": { "type": "string", "pattern": "^[a-z0-9_]+$" },
              "south": { "type": "string", "pattern": "^[a-z0-9_]+$" },
              "east": { "type": "string", "pattern": "^[a-z0-9_]+$" },
              "west": { "type": "string", "pattern": "^[a-z0-9_]+$" }
            }
          },
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            }
          },
          "monster": {
            "type": ["string", "null"],
            "pattern": "^[a-z0-9_]+$"
          }
        }
      }
    }
  }
}
