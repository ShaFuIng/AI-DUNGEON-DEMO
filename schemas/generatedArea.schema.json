{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-dungeon-demo.local/schemas/generatedArea.schema.json",
  "title": "Generated Area Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "theme",
    "narrativeHook",
    "difficulty",
    "rooms"
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/idString"
    },
    "name": {
      "$ref": "#/$defs/localizedText"
    },
    "theme": {
      "$ref": "#/$defs/localizedText"
    },
    "narrativeHook": {
      "$ref": "#/$defs/localizedText"
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "rooms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/room"
      }
    },
    "items": {
      "$ref": "#/$defs/itemMap"
    },
    "monsters": {
      "$ref": "#/$defs/monsterMap"
    },
    "skills": {
      "$ref": "#/$defs/skillMap"
    },
    "traps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/trap"
      }
    }
  },
  "$defs": {
    "idString": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "minLength": 3
    },
    "localizedText": {
      "type": "string",
      "minLength": 1
    },
    "directionExits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "north": {
          "$ref": "#/$defs/idString"
        },
        "south": {
          "$ref": "#/$defs/idString"
        },
        "east": {
          "$ref": "#/$defs/idString"
        },
        "west": {
          "$ref": "#/$defs/idString"
        }
      }
    },
    "room": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "exits",
        "items",
        "monster"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/idString"
        },
        "name": {
          "$ref": "#/$defs/localizedText"
        },
        "description": {
          "$ref": "#/$defs/localizedText"
        },
        "exits": {
          "$ref": "#/$defs/directionExits"
        },
        "items": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/idString"
          }
        },
        "monster": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "traps": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/idString"
          }
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "type",
        "usageHint"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/idString"
        },
        "name": {
          "$ref": "#/$defs/localizedText"
        },
        "description": {
          "$ref": "#/$defs/localizedText"
        },
        "type": {
          "type": "string",
          "enum": [
            "key",
            "quest",
            "consumable",
            "equipment",
            "material"
          ]
        },
        "usageHint": {
          "$ref": "#/$defs/localizedText"
        },
        "effect": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hp": {
              "type": "integer",
              "minimum": 0
            },
            "mp": {
              "type": "integer",
              "minimum": 0
            },
            "attack": {
              "type": "integer"
            },
            "defense": {
              "type": "integer"
            },
            "maxHp": {
              "type": "integer"
            },
            "maxMp": {
              "type": "integer"
            }
          }
        },
        "unlocks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/idString"
          }
        },
        "slot": {
          "type": "string",
          "enum": [
            "weapon",
            "armor",
            "accessory"
          ]
        },
        "stats": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "attack": {
              "type": "integer"
            },
            "defense": {
              "type": "integer"
            },
            "maxHp": {
              "type": "integer"
            },
            "maxMp": {
              "type": "integer"
            }
          }
        }
      }
    },
    "itemMap": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "$ref": "#/$defs/item"
        }
      }
    },
    "monster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "hp",
        "maxHp",
        "attack",
        "defense",
        "expReward",
        "drops"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/idString"
        },
        "name": {
          "$ref": "#/$defs/localizedText"
        },
        "description": {
          "$ref": "#/$defs/localizedText"
        },
        "hp": {
          "type": "integer",
          "minimum": 1
        },
        "maxHp": {
          "type": "integer",
          "minimum": 1
        },
        "attack": {
          "type": "integer",
          "minimum": 0
        },
        "defense": {
          "type": "integer",
          "minimum": 0
        },
        "expReward": {
          "type": "integer",
          "minimum": 0
        },
        "drops": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/idString"
          }
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "monsterMap": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "$ref": "#/$defs/monster"
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "mpCost",
        "damage"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/idString"
        },
        "name": {
          "$ref": "#/$defs/localizedText"
        },
        "description": {
          "$ref": "#/$defs/localizedText"
        },
        "mpCost": {
          "type": "integer",
          "minimum": 0
        },
        "damage": {
          "type": "integer",
          "minimum": 0
        },
        "effect": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "guard": {
              "type": "boolean"
            },
            "heal": {
              "type": "integer",
              "minimum": 0
            },
            "status": {
              "type": "string"
            }
          }
        }
      }
    },
    "skillMap": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "$ref": "#/$defs/skill"
        }
      }
    },
    "trap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "damage"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/idString"
        },
        "name": {
          "$ref": "#/$defs/localizedText"
        },
        "description": {
          "$ref": "#/$defs/localizedText"
        },
        "damage": {
          "type": "integer",
          "minimum": 0
        },
        "trigger": {
          "type": "string",
          "enum": [
            "enter_room",
            "take_item",
            "open_exit",
            "inspect"
          ]
        }
      }
    }
  }
}
